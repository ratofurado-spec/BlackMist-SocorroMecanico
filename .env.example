# Opcional. Copie para .env.local. Os contatos já estão definidos em src/config/business.ts
# (WhatsApp e telefone: 11 93333-2718); use estas variáveis apenas para sobrescrevê-los.

# WhatsApp: somente dígitos, DDI 55 + DDD + número.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Telefone para ligação, mesmo formato.
NEXT_PUBLIC_PHONE_NUMBER=

# Domínio definitivo, sem barra final (ex.: https://www.seudominio.com.br).
# Habilita canonical, sitemap com URL absoluta e URL nos dados estruturados.
NEXT_PUBLIC_SITE_URL=
